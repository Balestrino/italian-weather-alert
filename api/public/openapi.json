    "/v1/documents/{document_id}/versions/{version_id}/content": {
      "get": {
        "operationId": "get_document_content",
        "summary": "Download an archived document version",
        "description": "Disabled by default. Requires public copy access and current source publication permission. Returns the original bytes as an attachment.",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original retained bytes; Content-Type reflects the original media type.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "Copy access disabled or restricted by current source policy",
            "content": {
              "application/json": {
                "schema": {
