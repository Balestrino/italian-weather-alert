# Copy to .env on the dedicated production VM after operator approval.
# The image value must be the exact approved public GHCR digest.
COMPOSE_PROJECT_NAME=iwa-production
IWA_SECRETS_DIR=./.secrets
COMPOSE_FILE=compose.yaml:deploy/compose.production.yaml
IWA_APP_IMAGE=ghcr.io/balestrino/italian-weather-alert@sha256:REPLACE_WITH_APPROVED_DIGEST
IWA_PUBLIC_PORT=8080
IWA_ADMIN_PORT=8081
# Set proxy trust, public origin, tailnet origin and other site values privately.
