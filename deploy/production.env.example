# Copy to .local/production.env in the shared checkout.
# Replace the image placeholder with an operator-approved GHCR digest before
# pulling or starting production. No profile is enabled by default.
COMPOSE_PROJECT_NAME=iwa-production
IWA_SECRETS_DIR=./.local/production/secrets
IWA_APP_IMAGE=ghcr.io/balestrino/italian-weather-alert@sha256:REPLACE_WITH_APPROVED_DIGEST
IWA_PUBLIC_PORT=38080
IWA_ADMIN_PORT=38081
IWA_PUBLIC_COPY_ACCESS_ENABLED=false
# Set proxy trust, public origin, tailnet origin and other site values privately.
