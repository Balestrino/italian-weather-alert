# Copy to .local/development.env in the shared checkout.
# Keep this project name to preserve the existing development volumes.
COMPOSE_PROJECT_NAME=iwa
IWA_SECRETS_DIR=./.local/development/secrets
IWA_APP_IMAGE=iwa-app:development
IWA_PUBLIC_PORT=8080
IWA_ADMIN_PORT=8081

# Optional evaluated local chat/OCR fallback; see docs/operations/local-llm-fallback.md.
IWA_LOCAL_FALLBACK_ENABLED=false
IWA_LOCAL_FALLBACK_ENDPOINT=
IWA_LOCAL_FALLBACK_MODEL=
IWA_LOCAL_FALLBACK_SOURCES=
IWA_LOCAL_FALLBACK_TIMEOUT_SECONDS=180
IWA_LOCAL_FALLBACK_OCR_ENABLED=false
