# Copy to .local/development.env in the shared checkout.
# Keep this project name to preserve the existing development volumes.
COMPOSE_PROJECT_NAME=iwa
IWA_SECRETS_DIR=./.local/development/secrets
IWA_APP_IMAGE=iwa-app:development
# Optional image for a targeted public-listener repair; other services keep IWA_APP_IMAGE.
IWA_PUBLIC_IMAGE=
# Optional image for a targeted development worker rollout.
IWA_WORKER_IMAGE=
IWA_PUBLIC_PORT=8080
IWA_ADMIN_PORT=8081

# Primary providers; set both adapters/endpoints/models for exclusive local chat/OCR.
IWA_QWEN_ADAPTER=openai-chat
IWA_QWEN_ENDPOINT=https://api.regolo.ai/v1/chat/completions
IWA_QWEN_MODEL=qwen3.8-27b
IWA_QWEN_TIMEOUT_SECONDS=90
IWA_OCR_ADAPTER=openai-chat
IWA_OCR_ENDPOINT=https://api.regolo.ai/v1/chat/completions
IWA_OCR_MODEL=deepseek-ocr-2
IWA_OCR_TIMEOUT_SECONDS=90

# Optional evaluated local chat/OCR fallback; see docs/operations/local-llm-fallback.md.
IWA_LOCAL_FALLBACK_ENABLED=false
IWA_LOCAL_FALLBACK_ENDPOINT=
IWA_LOCAL_FALLBACK_MODEL=
IWA_LOCAL_FALLBACK_SOURCES=
IWA_LOCAL_FALLBACK_TIMEOUT_SECONDS=180
IWA_LOCAL_FALLBACK_OCR_ENABLED=false
